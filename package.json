{
  "name": "course-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Class project: a Courses@SLU style course search with fake data",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js --port=3001",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node scripts/seed.mjs",
    "test": "node --test \"server/test/*.test.js\" \"client/src/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.7"
  }
}
